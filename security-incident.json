go de Ticket</td>\n            <td style=\"color:#0f172a;font-weight:700;font-family:monospace;border-bottom:1px solid #e2e8f0;\">{{ $('Enriquecer').first().json.ticket_number }}</td>\n          </tr>\n          <tr>\n            <td style=\"color:#64748b;font-weight:600;border-bottom:1px solid #e2e8f0;\">Título del Suceso</td>\n            <td style=\"color:#0f172a;font-weight:600;border-bottom:1px solid #e2e8f0;\">{{ $('Enriquecer').first().json.title }}</td>\n          </tr>\n          <tr>\n            <td style=\"color:#64748b;font-weight:600;border-bottom:1px solid #e2e8f0;\">Categoría</td>\n            <td style=\"color:#0f172a;text-transform:capitalize;border-bottom:1px solid #e2e8f0;\">{{ $('Enriquecer').first().json.category }}</td>\n          </tr>\n          <tr>\n            <td style=\"color:#64748b;font-weight:600;border-bottom:1px solid #e2e8f0;\">Límite SLA</td>\n            <td style=\"color:#dc2626;font-weight:700;border-bottom:1px solid #e2e8f0;\">{{ $('Enriquecer').first().json.sla_hours }} horas de resolución</td>\n          </tr>\n          <tr>\n            <td style=\"color:#64748b;font-weight:600;\">Reportado Por</td>\n            <td style=\"color:#0f172a;\">{{ $('Enriquecer').first().json.reported_by || 'Chatbot IA' }}</td>\n          </tr>\n        </table>\n        <div style=\"text-align:center;margin:24px 0 10px;\">\n          <a href=\"http://localhost:3000/tickets/{{ $('Enriquecer').first().json.id }}\" style=\"display:inline-block;background-color:#4f46e5;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:6px;box-shadow:0 2px 4px rgba(79,70,229,0.3);\">\n            Gestionar Incidente en Plataforma →\n          </a>\n        </div>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"background-color:#f8fafc;padding:20px 32px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;line-height:1.5;\">\n        <b>SecBot Enterprise AI Cybersecurity</b> • Gestión Automatizada de Incidentes<br/>\n        Alineado con directivas NIST CSF 2.0 y Controles ISO/IEC 27001:2022.\n      </td>\n    </tr>\n  </table>\n</div>",
