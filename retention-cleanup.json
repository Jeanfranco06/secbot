{
  "name": "retention-cleanup",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 3 * * *" }] }
      },
      "id": "cron",
      "name": "Cron 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SECBOT_BASE_URL }}/api/v1/admin/retention/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "POST",
        "options": {}
      },
      "id": "http",
      "name": "POST Retención",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300],
      "credentials": { "httpHeaderAuth": { "id": "1", "name": "secbot-service-token" } }
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [{ "value1": "={{ $json.ok }}", "value2": true }]
        }
      },
      "id": "if-ok",
      "name": "IF OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#secbot-alertas", "mode": "name" },
        "text": "=🧹 Retención ejecutada\nChats: {{ $json.deleted.chat }}\nTickets: {{ $json.deleted.tickets }}\nReportes: {{ $json.deleted.reports }}"
      },
      "id": "slack-ok",
      "name": "Slack OK",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [860, 220],
      "credentials": { "slackApi": { "id": "1", "name": "secbot-slack" } }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#secbot-alertas", "mode": "name" },
        "text": "=⚠️ Retención falló: {{ JSON.stringify($json) }}"
      },
      "id": "slack-fail",
      "name": "Slack Fallo",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [860, 380],
      "credentials": { "slackApi": { "id": "1", "name": "secbot-slack" } }
    }
  ],
  "connections": {
    "Cron 03:00": { "main": [[{ "node": "POST Retención", "type": "main", "index": 0 }]] },
    "POST Retención": { "main": [[{ "node": "IF OK", "type": "main", "index": 0 }]] },
    "IF OK": {
      "main": [
        [{ "node": "Slack OK", "type": "main", "index": 0 }],
        [{ "node": "Slack Fallo", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "errorWorkflow": "error-handler", "timezone": "America/Lima" },
  "active": true,
  "tags": [{ "name": "secbot" }, { "name": "infra" }]
}