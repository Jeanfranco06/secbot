# SecBot Environment Configuration

# Database (PostgreSQL + pgvector)
POSTGRES_USER=secbot
POSTGRES_PASSWORD=secbot_secret
POSTGRES_DB=secbot

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_32_characters_long
JWT_ALGORITHM=RS256
JWT_ISSUER=secbot
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=7

# LLM & Embeddings
LLM_MODEL=llama3.2:3b-instruct-q4_K_M
EMBEDDING_MODEL=intfloat/multilingual-e5-large
OLLAMA_BASE_URL=http://ollama:11434
RERANK_ENABLED=false

# n8n Integration
N8N_USER=admin
N8N_PASSWORD=admin1234
N8N_ENCRYPTION_KEY=super_secret_encryption_key_32chars
N8N_SECRET=n8n_secret_token

# Observability
GRAFANA_PASSWORD=admin123

# Host Port Mapping
FRONTEND_PORT=3000
BACKEND_PORT=8000
N8N_PORT=5678
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443

# SMTP (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
