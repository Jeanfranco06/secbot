{
  "name": "incident-followup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "cron",
      "name": "Cron 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT t.id, t.ticket_number, t.severity, t.title, t.status,\n       t.created_at, t.reported_by,\n       u.email AS reporter_email, u.full_name AS reporter_name,\n       FLOOR(EXTRACT(EPOCH FROM (now() - t.created_at))/3600) AS hours_since\nFROM tickets t\nLEFT JOIN users u ON u.id = t.reported_by\nWHERE t.status IN ('nuevo','en_progreso')\n  AND t.created_at < now() - interval '24 hours'\n  AND COALESCE(t.metadata->>'followup_sent', 'false') <> 'true'\n  AND t.created_at > now() - interval '7 days'\nLIMIT 100;",
        "options": {}
      },
      "id": "pg-followup",
      "name": "PG Follow-up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        420,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "q3fVOjv3iIFfWdp0",
          "name": "secbot-db"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM || 'jean20francisco06@gmail.com' }}",
        "toEmail": "={{ ($json.reporter_email && !$json.reporter_email.endsWith('.local') && !$json.reporter_email.endsWith('.test')) ? $json.reporter_email : ($env.SECURITY_EMAIL || 'jean20francisco06@gmail.com') }}",
        "subject": "=[SECBOT] Seguimiento a tu reporte {{ $json.ticket_number }}",
        "html": "=<div style=\"background-color:#f1f5f9;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n  <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"max-width:600px;background-color:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 4px 16px rgba(15,23,42,0.08);border:1px solid #e2e8f0;\">\n    <tr>\n      <td style=\"background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);padding:26px 32px;border-bottom:3px solid #f59e0b;\">\n        <span style=\"font-size:11px;font-weight:700;letter-spacing:1px;color:#fde68a;text-transform:uppercase;\">SECBOT SOC \u2022 SEGUIMIENTO DE INCIDENTE</span>\n        <h1 style=\"margin:6px 0 0;font-size:20px;font-weight:800;color:#ffffff;\">Seguimiento a tu Reporte</h1>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"padding:28px 32px;\">\n        <p style=\"margin:0 0 18px;font-size:15px;color:#334155;line-height:1.5;\">\n          Hola <b>{{ $json.reporter_name }}</b>, te informamos que tu reporte de seguridad sigue en proceso de mitigaci\u00f3n por parte de los analistas del SOC:\n        </p>\n        <table width=\"100%\" border=\"0\" cellpadding=\"10\" cellspacing=\"0\" style=\"background-color:#f8fafc;border-radius:8px;border:1px solid #e2e8f0;margin-bottom:20px;font-size:13.5px;\">\n          <tr>\n            <td width=\"30%\" style=\"color:#64748b;font-weight:600;border-bottom:1px solid #e2e8f0;\">Ticket</td>\n            <td style=\"color:#0f172a;font-weight:700;font-family:monospace;border-bottom:1px solid #e2e8f0;\">{{ $json.ticket_number }}</td>\n          </tr>\n          <tr>\n            <td style=\"color:#64748b;font-weight:600;border-bottom:1px solid #e2e8f0;\">Severidad</td>\n            <td style=\"color:#0f172a;border-bottom:1px solid #e2e8f0;\"><b>{{ $json.severity }}</b></td>\n          </tr>\n          <tr>\n            <td style=\"color:#64748b;font-weight:600;border-bottom:1px solid #e2e8f0;\">Estado Actual</td>\n            <td style=\"color:#d97706;font-weight:700;text-transform:uppercase;border-bottom:1px solid #e2e8f0;\">{{ $json.status }}</td>\n          </tr>\n          <tr>\n            <td style=\"color:#64748b;font-weight:600;\">Tiempo Abierto</td>\n            <td style=\"color:#475569;\">Hace aproximadamente {{ Math.floor($json.hours_since) }} horas</td>\n          </tr>\n        </table>\n        <p style=\"font-size:13.5px;color:#475569;line-height:1.5;margin-bottom:20px;\">\n          Si dispones de capturas de pantalla o informaci\u00f3n adicional que facilite el an\u00e1lisis, puedes adjuntarla respondiendo a este mensaje o actualizando el ticket en la plataforma.\n        </p>\n        <div style=\"text-align:center;margin:24px 0 10px;\">\n          <a href=\"http://localhost:3000/tickets/{{ $json.id }}\" style=\"display:inline-block;background-color:#4f46e5;color:#ffffff;font-size:14px;font-weight:700;text-decoration:none;padding:12px 28px;border-radius:6px;\">\n            Revisar Estado en SecBot \u2192\n          </a>\n        </div>\n      </td>\n    </tr>\n    <tr>\n      <td style=\"background-color:#f8fafc;padding:20px 32px;border-top:1px solid #e2e8f0;font-size:12px;color:#64748b;line-height:1.5;\">\n        Equipo de Respuesta a Incidentes (CSIRT/SOC) \u2022 SecBot Enterprise.\n      </td>\n    </tr>\n  </table>\n</div>",
        "emailFormat": "html",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "email",
      "name": "Email Follow-up",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        640,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "HZxABrVSHtvU1Pk9",
          "name": "secbot-smtp"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE tickets\nSET metadata = COALESCE(metadata, '{}'::jsonb)\n  || jsonb_build_object('followup_sent', true, 'followup_at', now()::text)\nWHERE id = '{{ $('PG Follow-up').item.json.id }}';",
        "options": {}
      },
      "id": "pg-mark",
      "name": "PG Marcar Follow-up",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [
        860,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "q3fVOjv3iIFfWdp0",
          "name": "secbot-db"
        }
      }
    }
  ],
  "connections": {
    "Cron 10:00": {
      "main": [
        [
          {
            "node": "PG Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PG Follow-up": {
      "main": [
        [
          {
            "node": "Email Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Email Follow-up": {
      "main": [
        [
          {
            "node": "PG Marcar Follow-up",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "error-handler",
    "timezone": "America/Lima"
  },
  "active": true,
  "tags": [],
  "id": "secbot-wf-03"
}